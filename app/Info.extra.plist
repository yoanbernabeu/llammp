<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required by CoreAudio Tap on macOS 14.2+ for system audio capture. Without this
	     key the audio track is delivered dead, with no error at all. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>Llammp analyzes system audio to drive its visualizer.</string>

	<!-- Llammp drives Music.app through Apple Events. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Llammp controls Music.app to display and command playback.</string>

	<!-- Keep the Dock icon: Llammp is a normal windowed app. -->
	<key>LSUIElement</key>
	<false/>
</dict>
</plist>
